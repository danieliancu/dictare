# Copy to .env and adjust. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DATABASE_URL=postgres://dictare:dictare@127.0.0.1:5435/dictare
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000

# Text-to-speech
# Provider for generation commands: "openai" (real audio) or "mock" (offline placeholder).
TTS_PROVIDER=openai
# Never commit a real key. Only read from the environment.
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
# Product voices: marin (default), ballad, cedar — learners choose in their account settings.
TTS_VOICE=marin
TTS_AUDITION_VOICES=marin,ballad,cedar
# Bump to regenerate every recording after changing the generation strategy.
TTS_ENGINE_VERSION=2
# Development: serve pending audio too. Production must use True (approved audio only).
TTS_REQUIRE_APPROVAL=False
# Development only: create a *mock* placeholder when a phrase has no audio (never calls OpenAI).
TTS_GENERATE_ON_REQUEST=True
# Development only: read mock placeholders with the browser's en-GB voice (ignored in production).
TTS_BROWSER_FALLBACK=True

# Automatic audio QA (transcription + audio evaluator; runs only in generate_audio --auto-qa / qa_audio)
AUDIO_QA_ENABLED=True
AUDIO_QA_VERSION=2
AUDIO_QA_EVALUATOR_RUNS=2
AUDIO_QA_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AUDIO_QA_EVALUATOR_MODEL=gpt-audio
AUDIO_QA_AUTO_APPROVE_SCORE=90
AUDIO_QA_REVIEW_SCORE=75

# Email (console backend by default in development)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=dictare.ro <salut@dictare.ro>

# Optional: shared cache for rate limiting in production (e.g. redis://127.0.0.1:6379/1)
CACHE_URL=locmemcache://

# Content-Security-Policy: report-only by default; set to True to enforce
CSP_ENFORCE=False

LOG_LEVEL=INFO

# Social profiles for the footer (empty = shown as "în curând")
SOCIAL_YOUTUBE_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_X_URL=
