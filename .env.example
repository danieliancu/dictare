# Copy to .env and adjust. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DATABASE_URL=postgres://dictare:dictare@127.0.0.1:5435/dictare
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000

# Text-to-speech: "mock" (offline, no API key) or "openai"
TTS_PROVIDER=mock
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=fable
# In development, play mock variants with the browser's en-GB speech synthesis
TTS_BROWSER_FALLBACK=True

# Email (console backend by default in development)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=dictare.ro <salut@dictare.ro>

# Optional: shared cache for rate limiting in production (e.g. redis://127.0.0.1:6379/1)
CACHE_URL=locmemcache://

# Content-Security-Policy: report-only by default; set to True to enforce
CSP_ENFORCE=False

LOG_LEVEL=INFO

# Social profiles for the footer (empty = shown as "în curând")
SOCIAL_YOUTUBE_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_X_URL=
